#!/usr/bin/env bash

# ==========================================================
# MOTD Dashboard - Four Corners
# File: /etc/update-motd.d/00-welcome
# ==========================================================

export LC_ALL=C

# ----------------------------------------------------------
# Basic information
# ----------------------------------------------------------

HOST=$(hostname -s 2>/dev/null || hostname)
OS=$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-Linux}")
KERNEL=$(uname -r)
UPTIME=$(uptime -p 2>/dev/null | sed 's/^up //' || echo "Unknown")

# Detect terminal width reliably
COLS=160

if [[ -t 1 ]]; then
    TERM_COLS=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
    if [[ "$TERM_COLS" =~ ^[0-9]+$ ]] && (( TERM_COLS >= 80 )); then
        COLS=$TERM_COLS
    fi
fi

LEFT_WIDTH=$((COLS * 55 / 100))
(( LEFT_WIDTH < 35 )) && LEFT_WIDTH=35

# ----------------------------------------------------------
# COLORS AND TEXT STYLES
# ----------------------------------------------------------

# Text styles
RESET=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
ITALIC=$'\033[3m'
UNDERLINE=$'\033[4m'
BLINK=$'\033[5m'
REVERSE=$'\033[7m'
HIDDEN=$'\033[8m'
STRIKETHROUGH=$'\033[9m'

# Standard foreground colors
BLACK=$'\033[30m'
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
MAGENTA=$'\033[35m'
CYAN=$'\033[36m'
WHITE=$'\033[37m'

# Standard bold foreground colors
BOLD_BLACK=$'\033[1;30m'
BOLD_RED=$'\033[1;31m'
BOLD_GREEN=$'\033[1;32m'
BOLD_YELLOW=$'\033[1;33m'
BOLD_BLUE=$'\033[1;34m'
BOLD_MAGENTA=$'\033[1;35m'
BOLD_CYAN=$'\033[1;36m'
BOLD_WHITE=$'\033[1;37m'

# Bright foreground colors
BRIGHT_BLACK=$'\033[90m'
BRIGHT_RED=$'\033[91m'
BRIGHT_GREEN=$'\033[92m'
BRIGHT_YELLOW=$'\033[93m'
BRIGHT_BLUE=$'\033[94m'
BRIGHT_MAGENTA=$'\033[95m'
BRIGHT_CYAN=$'\033[96m'
BRIGHT_WHITE=$'\033[97m'

# Standard background colors
BG_BLACK=$'\033[40m'
BG_RED=$'\033[41m'
BG_GREEN=$'\033[42m'
BG_YELLOW=$'\033[43m'
BG_BLUE=$'\033[44m'
BG_MAGENTA=$'\033[45m'
BG_CYAN=$'\033[46m'
BG_WHITE=$'\033[47m'

# Bright background colors
BG_BRIGHT_BLACK=$'\033[100m'
BG_BRIGHT_RED=$'\033[101m'
BG_BRIGHT_GREEN=$'\033[102m'
BG_BRIGHT_YELLOW=$'\033[103m'
BG_BRIGHT_BLUE=$'\033[104m'
BG_BRIGHT_MAGENTA=$'\033[105m'
BG_BRIGHT_CYAN=$'\033[106m'
BG_BRIGHT_WHITE=$'\033[107m'


# field() {
#     printf '%s%s%s %s' "$BOLD_BLUE" "$1" "$RESET" "$2"
# }

field() {
    printf '%s%-18s%s %s' "$WHITE" "$1" "$RESET" "$2"
}

heading() {
    printf '%s%s%s' "$BG_BLUE" "$1" "$RESET"
}

# ----------------------------------------------------------
# TOP LEFT: Large server banner
# ----------------------------------------------------------

BANNER_PLAIN=()
BANNER_COLOR=()

if command -v figlet >/dev/null 2>&1; then
    mapfile -t BANNER_PLAIN < <(
        figlet -w "$LEFT_WIDTH" -f banner "$HOST" 2>/dev/null |
            sed '/^[[:space:]]*$/d'
    )

    if [[ -x /usr/games/lolcat ]]; then
        mapfile -t BANNER_COLOR < <(
            figlet -w "$LEFT_WIDTH" -f banner "$HOST" 2>/dev/null |
                sed '/^[[:space:]]*$/d' |
                /usr/games/lolcat -f 2>/dev/null
        )
    fi
fi

# Fallback if FIGlet is unavailable.
if (( ${#BANNER_PLAIN[@]} == 0 )); then
    BANNER_PLAIN=("$HOST")
fi

# Use cyan if lolcat is unavailable or its output differs.
if (( ${#BANNER_COLOR[@]} != ${#BANNER_PLAIN[@]} )); then
    BANNER_COLOR=()

    for line in "${BANNER_PLAIN[@]}"; do
        BANNER_COLOR+=("${BOLD_CYAN}${line}${RESET}")
    done
fi

# ----------------------------------------------------------
# TOP RIGHT: System health
# ----------------------------------------------------------

LOAD=$(awk '{print $1 " / " $2 " / " $3}' /proc/loadavg 2>/dev/null)
[[ -n "$LOAD" ]] || LOAD="Unknown"

MEMORY=$(free -h 2>/dev/null | awk '
    /^Mem:/ {
        gsub(/i$/, "", $3)
        gsub(/i$/, "", $2)
        printf "%s / %s (used / total)", $3, $2
    }
')
[[ -n "$MEMORY" ]] || MEMORY="Unknown"

DISK=$(df -hP / 2>/dev/null | awk '
    NR == 2 {
        gsub(/G$/, "Gb", $3)
        gsub(/G$/, "Gb", $2)
        printf "%s / %s (%s used)", $3, $2, $5
    }
')
[[ -n "$DISK" ]] || DISK="Unknown"

CPU_MODEL=$(awk -F ': ' '/^model name[[:space:]]*:/ {
    print $2
    exit
}' /proc/cpuinfo 2>/dev/null)

if [[ -z "$CPU_MODEL" ]]; then
    CPU_MODEL=$(awk -F ': ' '/^Hardware[[:space:]]*:/ {
        print $2
        exit
    }' /proc/cpuinfo 2>/dev/null)
fi

[[ -n "$CPU_MODEL" ]] || CPU_MODEL="Unknown"

FAILED=$(systemctl --failed --no-legend --plain 2>/dev/null |
    awk 'NF {n++} END {print n+0}')

if (( FAILED == 0 )); then
    SERVICES="${BOLD_GREEN}0${RESET}"
else
    SERVICES="${BOLD_RED}${FAILED}${RESET}"
fi

TOP_RIGHT=(
    "$(heading "${ITALIC}SYSTEM HEALTH${RESET}")"
    "$(field "Uptime:" "$UPTIME")"
    "$(field "CPU Model:" "$CPU_MODEL")"
    "$(field "Memory:" "$MEMORY")"
    "$(field "Load:" "$LOAD")"
    "$(field "Root Disk:" "$DISK")"
)

# ----------------------------------------------------------
# LOGIN INFORMATION: Current and previous SSH login
# ----------------------------------------------------------

IP="Unknown"
PREV_IP="Unknown"
PREV_LOGIN="Unknown"
LOGIN_USER=""

# Determine the login user without assuming the script's
# effective user is the SSH user.
if [[ -n "${PAM_USER:-}" ]]; then
    LOGIN_USER="$PAM_USER"
fi

# Try the current terminal's utmp record.
WHO_LINE=$(who -m 2>/dev/null | head -n 1)

if [[ -n "$WHO_LINE" ]]; then
    [[ -n "$LOGIN_USER" ]] ||
        LOGIN_USER=$(awk '{print $1}' <<< "$WHO_LINE")

    WHO_IP=$(awk '{
        addr = $NF
        gsub(/[()]/, "", addr)
        if (addr ~ /^[0-9a-fA-F:.]+$/) print addr
    }' <<< "$WHO_LINE")

    if [[ -n "$WHO_IP" ]]; then
        IP="$WHO_IP"
    fi
fi

# Prefer connection details when they are available.
if [[ -n "${SSH_CONNECTION:-}" ]]; then
    read -r IP _ <<< "$SSH_CONNECTION"
elif [[ -n "${SSH_CLIENT:-}" ]]; then
    read -r IP _ <<< "$SSH_CLIENT"
elif [[ -n "${PAM_RHOST:-}" ]]; then
    IP="$PAM_RHOST"
fi

# Resolve the original login user before falling back to root.
if [[ -z "$LOGIN_USER" ]]; then
    LOGIN_USER=$(logname 2>/dev/null || true)
fi

if [[ -z "$LOGIN_USER" && -n "${SUDO_USER:-}" ]]; then
    LOGIN_USER="$SUDO_USER"
fi

if [[ -z "$LOGIN_USER" ]]; then
    LOGIN_USER="${USER:-$(id -un)}"
fi

# If the current IP is still unknown, inspect recent SSH logs.
if [[ -z "$IP" || "$IP" == "Unknown" || "$IP" == "localhost" ]]; then
    LOG_LINES=$(journalctl \
        -u ssh.service -u sshd.service \
        --since "3 minutes ago" \
        --no-pager -o cat 2>/dev/null)

    IP=$(awk -v user="$LOGIN_USER" '
        index($0, "Accepted ") &&
        index($0, " for " user " from ") {
            for (i = 1; i < NF; i++) {
                if ($i == "from") ip = $(i+1)
            }
        }
        END { if (ip != "") print ip }
    ' <<< "$LOG_LINES")

    # Last-resort fallback if no username-specific entry is found.
    if [[ -z "$IP" ]]; then
        IP=$(awk '
            index($0, "Accepted ") {
                for (i = 1; i < NF; i++) {
                    if ($i == "from") ip = $(i+1)
                }
            }
            END { if (ip != "") print ip }
        ' <<< "$LOG_LINES")
    fi
fi

[[ -n "$IP" ]] || IP="Unknown"

# ----------------------------------------------------------
# Previous completed SSH login
# ----------------------------------------------------------
# Read the most recent completed pts/* login for this user.
# Skip the current session when it is still logged in.
#
# Expected last -i -F format:
# user pts/0 203.0.113.10 Mon Nov 9 14:20:00 2026
#
# The date is assembled from fields 4 through 8.

LAST_RECORD=$(last -i -F "$LOGIN_USER" 2>/dev/null | awk '
    $2 ~ /^pts\/[0-9]+$/ &&
    $3 ~ /^[0-9a-fA-F:.]+$/ &&
    $0 !~ /still logged in/ &&
    $0 !~ /wtmp begins/ {
        print $1 "|" $3 "|" $4 " " $5 " " $6 " " $7 " " $8
        exit
    }
')

PREV_USER="Unknown"
if [[ -n "$LAST_RECORD" ]]; then
    PREV_USER="${LAST_RECORD%%|*}"
    REMAINDER="${LAST_RECORD#*|}"

    PREV_IP="${REMAINDER%%|*}"
    PREV_DATE="${REMAINDER#*|}"

    PREV_LOGIN=$(date -d "$PREV_DATE" \
        '+%b %d, %Y %I:%M %p' 2>/dev/null || echo "Unknown")
else
    PREV_USER="Unknown"
fi

# ----------------------------------------------------------
# IP GEOLOCATION
# ----------------------------------------------------------

get_location() {
    local addr="$1"
    local result success city country

    if [[ -z "$addr" || "$addr" == "Unknown" ]]; then
        echo "Unavailable"
        return
    fi

    # Private, loopback, link-local and CGNAT IPv4 addresses,
    # plus common private and link-local IPv6 addresses.
    if [[ "$addr" =~ ^10\. ]] ||
       [[ "$addr" =~ ^192\.168\. ]] ||
       [[ "$addr" =~ ^172\.(1[6-9]|2[0-9]|3[01])\. ]] ||
       [[ "$addr" =~ ^127\. ]] ||
       [[ "$addr" =~ ^169\.254\. ]] ||
       [[ "$addr" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\. ]] ||
       [[ "$addr" == "::1" ]] ||
       [[ "$addr" =~ ^(fc|fd|fe80:) ]]; then
        echo "Private/VPN IP"
        return
    fi

    if ! command -v curl >/dev/null 2>&1 ||
       ! command -v jq >/dev/null 2>&1; then
        echo "Install curl and jq"
        return
    fi

    # HTTPS geolocation lookup requires outbound internet access.
    result=$(curl -fsS --max-time 3 \
        "https://ipwho.is/${addr}" 2>/dev/null) || {
        echo "Lookup unavailable"
        return
    }

    success=$(jq -r '.success // false' <<< "$result" 2>/dev/null)
    city=$(jq -r '.city // empty' <<< "$result" 2>/dev/null)
    country=$(jq -r '.country // empty' <<< "$result" 2>/dev/null)

    if [[ "$success" == "true" ]]; then
        if [[ -n "$city" && -n "$country" ]]; then
            printf '%s, %s\n' "$city" "$country"
        elif [[ -n "$country" ]]; then
            printf '%s\n' "$country"
        else
            echo "Location unavailable"
        fi
    else
        echo "Location unavailable"
    fi
}

LOCATION=$(get_location "$IP")
PREV_LOCATION=$(get_location "$PREV_IP")

# ----------------------------------------------------------
# BOTTOM LEFT: Server information
# ----------------------------------------------------------

BOTTOM_LEFT=(
    "$(heading "${ITALIC}SERVER INFORMATION${RESET}")"
    "$(field "Distribution:" "$OS")"
    "$(field "Kernel:" "$KERNEL")"
    "$(field "Failed Services:" "$SERVICES")"
)

# ----------------------------------------------------------
# BOTTOM RIGHT: Current and previous login information
# ----------------------------------------------------------

BOTTOM_RIGHT=(
    "$(heading "${ITALIC}LOGIN INFORMATION"${RESET})"
    "$(field "Current IP:" "${BOLD_BLUE}${IP}${RESET} | ${ITALIC}Location${RESET}: $LOCATION")"
    "$(field "Previous Login:" "${PREV_USER} | ${PREV_LOGIN}")"
    "$(field "Previous IP:" "${BOLD_BLUE}${PREV_IP}${RESET} | ${ITALIC}Location${RESET}: $PREV_LOCATION")"
)

# ----------------------------------------------------------
# Render one row of two columns.
# ANSI escape codes are excluded from width calculations.
# ----------------------------------------------------------

strip_ansi() {
    sed $'s/\033\\[[0-9;]*m//g'
}

print_pair() {
    local left_plain="$1"
    local left_render="$2"
    local right_render="$3"
    local padding

    padding=$((LEFT_WIDTH - ${#left_plain}))
    (( padding < 2 )) && padding=2

    printf '%s%*s%s%s\n' \
        "$left_render" "$padding" "" "$right_render" "$RESET"
}

# ----------------------------------------------------------
# Draw the four-corner dashboard
# ----------------------------------------------------------

printf '\n'

# TOP: Server banner + system health.
TOP_LINES=${#BANNER_PLAIN[@]}
(( ${#TOP_RIGHT[@]} > TOP_LINES )) && TOP_LINES=${#TOP_RIGHT[@]}

for ((i = 0; i < TOP_LINES; i++)); do
    left_plain="${BANNER_PLAIN[$i]:-}"
    left_render="${BANNER_COLOR[$i]:-}"
    right_render="${TOP_RIGHT[$i]:-}"

    print_pair "$left_plain" "$left_render" "$right_render"
done

printf '\n'

# BOTTOM: Server information + login information.
BOTTOM_LINES=${#BOTTOM_LEFT[@]}
(( ${#BOTTOM_RIGHT[@]} > BOTTOM_LINES )) &&
    BOTTOM_LINES=${#BOTTOM_RIGHT[@]}

for ((i = 0; i < BOTTOM_LINES; i++)); do
    left_render="${BOTTOM_LEFT[$i]:-}"
    right_render="${BOTTOM_RIGHT[$i]:-}"

    left_plain=$(printf '%s' "$left_render" | strip_ansi)

    print_pair "$left_plain" "$left_render" "$right_render"
done

printf '\n'
