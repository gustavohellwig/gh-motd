#!/usr/bin/env bash

# ==========================================================
# MOTD Dashboard - Four Corners
# File: /etc/update-motd.d/00-welcome
# ==========================================================

export LC_ALL=C
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ----------------------------------------------------------
# BASIC INFORMATION
# ----------------------------------------------------------

HOST=$(hostname -s 2>/dev/null || hostname)
OS=$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-Linux}")
KERNEL=$(uname -r)
UPTIME=$(uptime -p 2>/dev/null | sed 's/^up //' || echo "Unknown")

# CPU model: usually the virtual CPU model on a VM.
CPU_CORES=$(nproc)
CPU_MODEL=$(lscpu | sed -n 's/^Model name:[[:space:]]*//p' | head -n1 | sed 's/ (.*)//')
# More reliable fallback for systems without "model name".
if [[ -z "$CPU_MODEL" ]]; then
    CPU_MODEL=$(lscpu 2>/dev/null |
        awk -F ': *' '/^Model name:/ {print $2; exit}')
fi

[[ -n "$CPU_MODEL" ]] || CPU_MODEL="Unknown"

# Detect terminal width.
COLS=160

if [[ -t 1 ]]; then
    TERM_COLS=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
    if [[ "$TERM_COLS" =~ ^[0-9]+$ ]] && (( TERM_COLS >= 80 )); then
        COLS=$TERM_COLS
    fi
fi

LEFT_WIDTH=$((COLS * 55 / 100))
(( LEFT_WIDTH < 35 )) && LEFT_WIDTH=35

# ----------------------------------------------------------
# COLORS AND TEXT STYLES
# ----------------------------------------------------------

RESET=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
ITALIC=$'\033[3m'
UNDERLINE=$'\033[4m'
REVERSE=$'\033[7m'
STRIKETHROUGH=$'\033[9m'

# Standard foreground colors.
BLACK=$'\033[30m'
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
MAGENTA=$'\033[35m'
CYAN=$'\033[36m'
WHITE=$'\033[37m'

# Bold foreground colors.
BOLD_BLACK=$'\033[1;30m'
BOLD_RED=$'\033[1;31m'
BOLD_GREEN=$'\033[1;32m'
BOLD_YELLOW=$'\033[1;33m'
BOLD_BLUE=$'\033[1;34m'
BOLD_MAGENTA=$'\033[1;35m'
BOLD_CYAN=$'\033[1;36m'
BOLD_WHITE=$'\033[1;37m'

# Bright foreground colors.
BRIGHT_BLACK=$'\033[90m'
BRIGHT_RED=$'\033[91m'
BRIGHT_GREEN=$'\033[92m'
BRIGHT_YELLOW=$'\033[93m'
BRIGHT_BLUE=$'\033[94m'
BRIGHT_MAGENTA=$'\033[95m'
BRIGHT_CYAN=$'\033[96m'
BRIGHT_WHITE=$'\033[97m'

# 256-color examples for custom accents.
PURPLE=$'\033[38;5;141m'
ORANGE=$'\033[38;5;208m'
GOLD=$'\033[38;5;220m'
SKY_BLUE=$'\033[38;5;117m'
MINT_GREEN=$'\033[38;5;121m'
PINK=$'\033[38;5;205m'

field() {
    printf '%s%-18s%s %s' "$WHITE" "$1" "$RESET" "$2"
}

heading() {
    printf '%s%s%s' "${BLUE}${BOLD}" "$1" "$RESET"
}

# ----------------------------------------------------------
# TOP LEFT: SERVER BANNER
# ----------------------------------------------------------

BANNER_PLAIN=()
BANNER_COLOR=()

if command -v figlet >/dev/null 2>&1; then
    mapfile -t BANNER_PLAIN < <(
        figlet -w "$LEFT_WIDTH" -f banner "$HOST" 2>/dev/null |
            sed '/^[[:space:]]*$/d'
    )

    if [[ -x /usr/games/lolcat ]]; then
        mapfile -t BANNER_COLOR < <(
            figlet -w "$LEFT_WIDTH" -f banner "$HOST" 2>/dev/null |
                sed '/^[[:space:]]*$/d' |
                /usr/games/lolcat -f 2>/dev/null
        )
    fi
fi

if (( ${#BANNER_PLAIN[@]} == 0 )); then
    BANNER_PLAIN=("$HOST")
fi

if (( ${#BANNER_COLOR[@]} != ${#BANNER_PLAIN[@]} )); then
    BANNER_COLOR=()
    for line in "${BANNER_PLAIN[@]}"; do
        BANNER_COLOR+=("${CYAN}${line}${RESET}")
    done
fi

# ----------------------------------------------------------
# TOP RIGHT: SYSTEM HEALTH
# ----------------------------------------------------------

LOAD=$(awk '{print $1 " / " $2 " / " $3}' /proc/loadavg 2>/dev/null)
[[ -n "$LOAD" ]] || LOAD="Unknown"

MEMORY=$(free -h 2>/dev/null | awk '
    /^Mem:/ {
        gsub(/i/, "", $3)
        gsub(/i/, "", $2)
        printf "%s / %s (used / total)", $3, $2
    }
')
[[ -n "$MEMORY" ]] || MEMORY="Unknown"

# Root filesystem space.
DISK=$(df -hP / 2>/dev/null | awk '
    NR == 2 {
        gsub(/G$/, "Gb", $3)
        gsub(/G$/, "Gb", $2)
        printf "%s / %s (%s used)", $3, $2, $5
    }
')
[[ -n "$DISK" ]] || DISK="Unknown"

# Root filesystem inode usage.
INODES=$(df -iP / 2>/dev/null | awk '
    NR == 2 {
        printf "%s used (%s)", $3, $5
    }
')
[[ -n "$INODES" ]] || INODES="Unknown"

# Failed systemd services.
FAILED=$(systemctl --failed --no-legend --plain 2>/dev/null |
    awk 'NF {n++} END {print n+0}')

if (( FAILED == 0 )); then
    SERVICES="${GREEN}0${RESET}"
else
    SERVICES="${RED}${FAILED}${RESET}"
fi

# ----------------------------------------------------------
# SECURITY STATUS
# ----------------------------------------------------------

# Count all package updates in the local APT cache.
# This is not a security-only update count.
PENDING_UPDATES=$(apt list --upgradable 2>/dev/null |
    awk 'NR > 1 && !/^Listing/ {n++} END {print n+0}')

# Failed SSH authentication events in the previous hour.
# Do not report zero if the journal is unavailable.
SSH_LOGS=$(journalctl \
    -u ssh.service -u sshd.service \
    --since "1 hour ago" \
    --no-pager -o cat 2>/dev/null)

if [[ -n "$SSH_LOGS" ]]; then
    FAILED_SSH=$(awk '
        /Failed password|Invalid user|authentication failure/ {
            n++
        }
        END {print n+0}
    ' <<< "$SSH_LOGS")

    if (( FAILED_SSH > 0 )); then
        FAILED_SSH_DISPLAY="${BOLD_RED}${FAILED_SSH}${RESET}"
    else
        FAILED_SSH_DISPLAY="${BOLD_GREEN}0${RESET}"
    fi
else
    FAILED_SSH_DISPLAY="Unavailable"
fi

unset SSH_LOGS

# Fail2ban status.
SHOW_FAIL2BAN=false

if command -v fail2ban-client >/dev/null 2>&1; then
    SHOW_FAIL2BAN=true

    if systemctl is-active --quiet fail2ban; then
        FAIL2BAN="${GREEN}Active${RESET}"
    else
        FAIL2BAN="${RED}Inactive${RESET}"
    fi
fi

TOP_RIGHT=(
    "$(heading "SERVER INFORMATION")"
    "$(field "Distribution:" "$OS")"
    "$(field "Kernel:" "$KERNEL")"
    "$(field "CPU Model:" "$CPU_MODEL" | CPU_CORES)"
    "$(field "Uptime:" "$UPTIME")"
    "$(field "Failed Services:" "$SERVICES")"
)

# ----------------------------------------------------------
# LOGIN INFORMATION: CURRENT SESSION
# ----------------------------------------------------------

IP="Unknown"
LOGIN_USER="${PAM_USER:-}"
PREV_USER="Unknown"
PREV_IP="Unknown"
PREV_LOGIN="Unknown"

# Identify the current terminal's login user and source IP.
WHO_LINE=$(who -m 2>/dev/null | head -n 1)

if [[ -n "$WHO_LINE" ]]; then
    if [[ -z "$LOGIN_USER" ]]; then
        LOGIN_USER=$(awk '{print $1}' <<< "$WHO_LINE")
    fi

    WHO_IP=$(awk '{
        addr = $NF
        gsub(/[()]/, "", addr)
        if (addr ~ /^[0-9a-fA-F:.]+$/) print addr
    }' <<< "$WHO_LINE")

    if [[ -n "$WHO_IP" ]]; then
        IP="$WHO_IP"
    fi
fi

# Prefer SSH connection details when the environment provides them.
if [[ -n "${SSH_CONNECTION:-}" ]]; then
    read -r IP _ <<< "$SSH_CONNECTION"
elif [[ -n "${SSH_CLIENT:-}" ]]; then
    read -r IP _ <<< "$SSH_CLIENT"
elif [[ -n "${PAM_RHOST:-}" ]]; then
    IP="$PAM_RHOST"
fi

# Resolve the original login user before falling back to the
# effective user, which may be root after sudo -s.
if [[ -z "$LOGIN_USER" ]]; then
    LOGIN_USER=$(logname 2>/dev/null || true)
fi

if [[ -z "$LOGIN_USER" && -n "${SUDO_USER:-}" ]]; then
    LOGIN_USER="$SUDO_USER"
fi

if [[ -z "$LOGIN_USER" ]]; then
    LOGIN_USER="${USER:-$(id -un)}"
fi

# If the current IP is unknown, consult recent SSH logs ONLY for
# the identified login user. Never attribute another user's IP.
if [[ -z "$IP" || "$IP" == "Unknown" || "$IP" == "localhost" ]]; then
    if [[ -n "$LOGIN_USER" ]]; then
        LOG_LINES=$(journalctl \
            -u ssh.service -u sshd.service \
            --since "3 minutes ago" \
            --no-pager -o cat 2>/dev/null)

        MATCHED_IP=$(awk -v user="$LOGIN_USER" '
            index($0, "Accepted ") &&
            index($0, " for " user " from ") {
                for (i = 1; i < NF; i++) {
                    if ($i == "from") ip = $(i+1)
                }
            }
            END { if (ip != "") print ip }
        ' <<< "$LOG_LINES")

        if [[ -n "$MATCHED_IP" ]]; then
            IP="$MATCHED_IP"
        fi
    fi
fi

[[ -n "$IP" ]] || IP="Unknown"

# ----------------------------------------------------------
# PREVIOUS COMPLETED SSH LOGIN
# ----------------------------------------------------------
# Restrict history to pts/* sessions and skip sessions that are
# still logged in. The record includes username, IP and date.
#
# Typical last -i -F format:
# user pts/0 203.0.113.10 Mon Nov 9 14:20:00 2026

LAST_RECORD=$(last -i -F "$LOGIN_USER" 2>/dev/null | awk '
    $2 ~ /^pts\/[0-9]+$/ &&
    $3 ~ /^[0-9a-fA-F:.]+$/ &&
    $0 !~ /still logged in/ &&
    $0 !~ /wtmp begins/ {
        print $1 "|" $3 "|" $4 " " $5 " " $6 " " $7 " " $8
        exit
    }
')

if [[ -n "$LAST_RECORD" ]]; then
    PREV_USER="${LAST_RECORD%%|*}"
    LAST_REMAINDER="${LAST_RECORD#*|}"

    PREV_IP="${LAST_REMAINDER%%|*}"
    PREV_DATE="${LAST_REMAINDER#*|}"

    PREV_LOGIN=$(date -d "$PREV_DATE" \
        '+%b %d, %Y %I:%M %p' 2>/dev/null || echo "Unknown")
fi

# ----------------------------------------------------------
# IP GEOLOCATION
# ----------------------------------------------------------
# Public IP addresses are sent to ipwho.is.
# Private/non-global IPs are not sent to the service.

get_location() {
    local addr="$1"
    local result success city country scope

    if [[ -z "$addr" || "$addr" == "Unknown" ]]; then
        echo "Unavailable"
        return
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo "Install python3"
        return
    fi

    # Validate the address and classify it using Python's ipaddress.
    scope=$(python3 -c '
import ipaddress, sys
try:
    ip = ipaddress.ip_address(sys.argv[1])
    print("public" if ip.is_global else "private")
except ValueError:
    print("invalid")
' "$addr" 2>/dev/null) || scope="invalid"

    case "$scope" in
        private)
            echo "Private/VPN IP"
            return
            ;;
        invalid)
            echo "Invalid IP"
            return
            ;;
        public)
            ;;
        *)
            echo "Unavailable"
            return
            ;;
    esac

    if ! command -v curl >/dev/null 2>&1 ||
       ! command -v jq >/dev/null 2>&1; then
        echo "Install curl and jq"
        return
    fi

    result=$(curl -fsS --connect-timeout 1 --max-time 2 \
        "https://ipwho.is/${addr}" 2>/dev/null) || {
        echo "Lookup unavailable"
        return
    }

    success=$(jq -r '.success // false' <<< "$result" 2>/dev/null)

    # Strip terminal control characters from external response fields.
    city=$(jq -r '.city // empty' <<< "$result" 2>/dev/null |
        tr -d '[:cntrl:]')
    country=$(jq -r '.country // empty' <<< "$result" 2>/dev/null |
        tr -d '[:cntrl:]')

    if [[ "$success" == "true" ]]; then
        if [[ -n "$city" && -n "$country" ]]; then
            printf '%s, %s\n' "$city" "$country"
        elif [[ -n "$country" ]]; then
            printf '%s\n' "$country"
        else
            echo "Location unavailable"
        fi
    else
        echo "Location unavailable"
    fi
}

LOCATION=$(get_location "$IP")
PREV_LOCATION=$(get_location "$PREV_IP")

# ----------------------------------------------------------
# BOTTOM LEFT: SERVER AND SECURITY INFORMATION
# ----------------------------------------------------------

BOTTOM_LEFT=(
    "$(heading "SYSTEM HEALTH")"
    "$(field "Memory:" "$MEMORY")"
    "$(field "Load:" "$LOAD")"
    "$(field "Root Disk:" "$DISK")"
    "$(field "Root Inodes:" "$INODES")"
    "$(heading "SECURITY STATUS")"
    "$(field "Updates Pending:" "$PENDING_UPDATES")"
)
if [[ "$SHOW_FAIL2BAN" == true ]]; then
    BOTTOM_LEFT+=(
        "$(field "Failed SSH (1h):" "$FAILED_SSH_DISPLAY")"
        "$(field "Fail2ban:" "$FAIL2BAN")"
    )
fi

# ----------------------------------------------------------
# BOTTOM RIGHT: LOGIN INFORMATION
# ----------------------------------------------------------

BOTTOM_RIGHT=(
    "$(heading "LOGIN INFORMATION")"
    "$(field "Current Login:" "$LOGIN_USER")"
    "$(field "Current IP:" "${CYAN}${IP}${RESET} | Location: ${LOCATION}")"
    "$(field "Previous Login:" "${PREV_USER} | ${PREV_LOGIN}")"
    "$(field "Previous IP:" "${CYAN}${PREV_IP}${RESET} | Location: ${PREV_LOCATION}")"
)

# ----------------------------------------------------------
# RENDERING HELPERS
# ----------------------------------------------------------

strip_ansi() {
    sed $'s/\033\\[[0-9;]*m//g'
}

print_pair() {
    local left_plain="$1"
    local left_render="$2"
    local right_render="$3"
    local padding

    padding=$((LEFT_WIDTH - ${#left_plain}))
    (( padding < 2 )) && padding=2

    printf '%s%*s%s%s\n' \
        "$left_render" "$padding" "" "$right_render" "$RESET"
}

# ----------------------------------------------------------
# DRAW THE FOUR-CORNER DASHBOARD
# ----------------------------------------------------------

printf '\n'

# TOP: server banner + system health.
TOP_LINES=${#BANNER_PLAIN[@]}
(( ${#TOP_RIGHT[@]} > TOP_LINES )) && TOP_LINES=${#TOP_RIGHT[@]}

for ((i = 0; i < TOP_LINES; i++)); do
    left_plain="${BANNER_PLAIN[$i]:-}"
    left_render="${BANNER_COLOR[$i]:-}"
    right_render="${TOP_RIGHT[$i]:-}"

    print_pair "$left_plain" "$left_render" "$right_render"
done

printf '\n'

# BOTTOM: server/security information + login information.
BOTTOM_LINES=${#BOTTOM_LEFT[@]}
(( ${#BOTTOM_RIGHT[@]} > BOTTOM_LINES )) &&
    BOTTOM_LINES=${#BOTTOM_RIGHT[@]}

for ((i = 0; i < BOTTOM_LINES; i++)); do
    left_render="${BOTTOM_LEFT[$i]:-}"
    right_render="${BOTTOM_RIGHT[$i]:-}"
    left_plain=$(printf '%s' "$left_render" | strip_ansi)

    print_pair "$left_plain" "$left_render" "$right_render"
done

printf '\n'
